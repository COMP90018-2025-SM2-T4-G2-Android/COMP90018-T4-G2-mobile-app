<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Card Style -->
    <style name="CashPalCard">
        <item name="android:background">@drawable/bg_qr_container</item>
        <item name="android:elevation">6dp</item>
        <item name="android:translationZ">3dp</item>
        <item name="android:outlineProvider">background</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Primary Button -->
    <style name="CashPalButtonPrimary">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:elevation">3dp</item>
        <item name="android:translationZ">2dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <!-- Outline Button -->
    <style name="CashPalButtonOutline">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:elevation">3dp</item>
        <item name="android:translationZ">2dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

</resources>
