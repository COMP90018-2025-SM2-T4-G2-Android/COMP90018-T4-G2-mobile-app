<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="96dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/scan_option_background"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                app:tint="@color/foreground"
                android:layout_marginEnd="16dp" />

            <!-- Title Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan Result"
                    android:textColor="@color/foreground"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QR code detected successfully"
                    android:textColor="@color/muted_foreground"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Success Animation Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <!-- Success Icon -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="@color/success"
                    android:alpha="0.2"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_trending_up"
                        android:rotation="45"
                        app:tint="@color/success" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan Successful!"
                    android:textColor="@color/success"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QR code information retrieved"
                    android:textColor="@color/success"
                    android:textSize="14sp"
                    android:alpha="0.8" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Scanned Information Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Scanned Data Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Avatar/Icon Container -->
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/scan_option_background"
                        android:backgroundTint="@color/primary"
                        android:alpha="0.1"
                        android:layout_marginEnd="16dp">

                        <!-- Person Avatar -->
                        <FrameLayout
                            android:id="@+id/fl_person_avatar"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="@color/primary"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tv_avatar_initials"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="SJ"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </FrameLayout>

                        <!-- Store Icon -->
                        <ImageView
                            android:id="@+id/iv_store_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_store"
                            app:tint="@color/primary"
                            android:visibility="gone" />

                        <!-- QR Code Icon (Payment) -->
                        <ImageView
                            android:id="@+id/iv_qr_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_qr_scanner"
                            app:tint="@color/primary"
                            android:visibility="gone" />

                    </FrameLayout>

                    <!-- Scanned Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_scanned_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sarah Johnson"
                            android:textColor="@color/foreground"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <ImageView
                                android:id="@+id/iv_identifier_icon"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_person"
                                app:tint="@color/muted_foreground"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:id="@+id/tv_scanned_identifier"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+1 (555) 987-6543"
                                android:textColor="@color/muted_foreground"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_scanned_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="123 Main St, Downtown"
                            android:textColor="@color/muted_foreground"
                            android:textSize="12sp"
                            android:visibility="gone"
                            android:layout_marginBottom="8dp" />

                        <!-- Amount Badge -->
                        <LinearLayout
                            android:id="@+id/ll_amount_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/scan_option_background"
                            android:backgroundTint="@color/primary"
                            android:alpha="0.1"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Amount: "
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_scanned_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$28.75"
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Separator -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border"
                    android:layout_marginVertical="16dp" />

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Person Actions -->
                    <LinearLayout
                        android:id="@+id/ll_person_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btn_send_money"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/primary_button_background"
                            android:text="Send Money"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:drawableStart="@drawable/ic_send"
                            android:drawablePadding="12dp"
                            android:gravity="center"
                            android:layout_marginBottom="12dp" />

                        <Button
                            android:id="@+id/btn_add_contact"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/scan_option_background"
                            android:text="Add to Contacts"
                            android:textColor="@color/foreground"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:drawableStart="@drawable/ic_person"
                            android:drawablePadding="12dp"
                            android:gravity="center"
                            android:layout_marginBottom="12dp" />

                    </LinearLayout>

                    <!-- Store/Payment Actions -->
                    <LinearLayout
                        android:id="@+id/ll_payment_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btn_make_payment"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/primary_button_background"
                            android:text="Make Payment"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:drawableStart="@drawable/ic_send"
                            android:drawablePadding="12dp"
                            android:gravity="center"
                            android:layout_marginBottom="12dp" />

                        <Button
                            android:id="@+id/btn_save_favorite"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/scan_option_background"
                            android:text="Save to Favorites"
                            android:textColor="@color/foreground"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:drawableStart="@drawable/ic_store"
                            android:drawablePadding="12dp"
                            android:gravity="center"
                            android:layout_marginBottom="12dp" />

                    </LinearLayout>

                    <!-- Scan Another Code Button -->
                    <Button
                        android:id="@+id/btn_scan_another"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:text="Scan Another Code"
                        android:textColor="@color/muted_foreground"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Quick Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- View History -->
            <LinearLayout
                android:id="@+id/btn_view_history"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/scan_option_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_history"
                    app:tint="@color/primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View History"
                    android:textColor="@color/foreground"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Scan Again -->
            <LinearLayout
                android:id="@+id/btn_scan_again"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/scan_option_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan Again"
                    android:textColor="@color/foreground"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>