<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/app_background">

    <TextView
        android:id="@+id/csvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/csv_viewer_title"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:paddingBottom="12dp" />

    <WebView
        android:id="@+id/csvWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="12dp">

        <Button
            android:id="@+id/btnCloseCsv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/csv_close_button" />

        <Button
            android:id="@+id/btnShareCsv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/csv_share_button" />
    </LinearLayout>

</LinearLayout>
