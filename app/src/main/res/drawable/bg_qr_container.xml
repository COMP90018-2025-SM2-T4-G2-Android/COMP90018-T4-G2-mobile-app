<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Soft rounded square look -->
    <corners android:radius="24dp" />
    <solid android:color="@color/card" />
    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp" />
    <!-- Optional subtle shadow border (like your Figma) -->
    <stroke
        android:width="1dp"
        android:color="@color/card_shadow" />
</shape>
